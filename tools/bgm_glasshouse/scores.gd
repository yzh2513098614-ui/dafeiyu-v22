		[9.0, "G5", 1.0, 0.50], [10.0, "F5", 1.0, 0.52], [11.0, "Eb5", 1.0, 0.48],
		[12.0, "Db5", 2.0, 0.54], [14.0, "C5", 1.0, 0.48], [15.0, "Bb4", 1.0, 0.46],
		[16.0, "C5", 1.0, 0.52], [17.0, "Eb5", 1.0, 0.50], [18.0, "F5", 1.0, 0.52],
		[19.0, "Eb5", 1.0, 0.48], [20.0, "Db5", 1.0, 0.50], [21.0, "C5", 1.0, 0.48],
		[22.0, "Bb4", 2.0, 0.50],
	], 0.36)
	# 终句：收在主音
	_phrase(40, bpb, [
		[0.0, "Ab4", 1.0, 0.52], [1.0, "C5", 1.0, 0.48], [2.0, "Eb5", 1.0, 0.50],
		[3.0, "Ab5", 1.0, 0.52], [4.0, "G5", 1.0, 0.48], [5.0, "F5", 1.0, 0.46],
		[6.0, "Eb5", 1.0, 0.50], [7.0, "C5", 1.0, 0.46], [8.0, "Db5", 1.0, 0.52],
		[9.0, "C5", 1.0, 0.48], [10.0, "Bb4", 1.0, 0.46], [11.0, "Ab4", 1.0, 0.48],
		[12.0, "C5", 1.0, 0.50], [13.0, "Eb5", 1.0, 0.46], [14.0, "C5", 1.0, 0.44],
		[15.0, "Ab4", 1.0, 0.46], [16.0, "Bb4", 1.0, 0.48], [17.0, "C5", 1.0, 0.46],
		[18.0, "Ab4", 4.0, 0.52],
	], 0.36)
	for bar in [3, 7, 11, 15, 19, 23, 27]:
		_mb(bar, bpb, [[0.0, "Eb6", 1.4, 0.26], [1.5, "C6", 1.4, 0.20]], 0.50)

	return _track("glasshouse_02_meeting", "相遇", 132.0, "3/4", 48, 202)


# ─────────────────────────── 3. 思念 ───────────────────────────

func _t_longing() -> Dictionary:
	ev = []
	var bpb := 4
	var prog := ["Am", "F", "C", "G", "Am", "F", "Dm7", "E7",
		"Am", "F", "C", "G", "F", "G", "Am", "Am",
		"Am", "F", "C", "G", "F", "Dm7", "E7", "Am"]
	for bar in prog.size():
		var low: int = Theory.chord(prog[bar], 33)[0]
		# 左手几乎只有低音长音，留出大片空白
		_ev("piano", float(bar * bpb), low, 5.2, 0.30, -0.48)
		if bar % 4 == 2:
			_ev("piano", float(bar * bpb + 2.0), low + 12, 2.4, 0.16, -0.38)
		# 弦乐垫主导
		_pad(bar, bpb, Theory.chord(prog[bar], 57), 1, 0.48 if bar >= 8 else 0.36)

	_phrase(0, bpb, [
		[0.0, "A4", 3.0, 0.40], [3.0, "C5", 1.0, 0.34],
		[4.0, "B4", 3.0, 0.38], [7.0, "A4", 1.0, 0.32],
		[8.0, "C5", 2.0, 0.40], [10.0, "D5", 2.0, 0.36],
		[12.0, "B4", 4.0, 0.38],
		[16.0, "A4", 2.0, 0.40], [18.0, "G4", 2.0, 0.34],
		[20.0, "F4", 3.0, 0.38], [23.0, "G4", 1.0, 0.32],
		[24.0, "A4", 4.0, 0.40],
	], 0.30)
	_phrase(8, bpb, [
		[0.0, "E5", 3.0, 0.44], [3.0, "D5", 1.0, 0.36],
		[4.0, "C5", 3.0, 0.40], [7.0, "B4", 1.0, 0.32],
		[8.0, "D5", 2.0, 0.42], [10.0, "E5", 2.0, 0.38],
		[12.0, "D5", 4.0, 0.40],
		[16.0, "C5", 2.0, 0.42], [18.0, "B4", 2.0, 0.36],
		[20.0, "A4", 4.0, 0.42],
	], 0.30)
	# 第三句：弦乐垫顶上，钢琴退到点缀
	_phrase(16, bpb, [
		[0.0, "A4", 4.0, 0.30], [4.0, "G4", 4.0, 0.28],
		[8.0, "F4", 4.0, 0.30], [12.0, "E4", 4.0, 0.28],
		[16.0, "F4", 4.0, 0.32], [20.0, "G4", 4.0, 0.30],
		[24.0, "C5", 4.0, 0.32], [28.0, "A4", 4.0, 0.30],
