extends RefCounted
## 《玻璃温室》乐谱定义：正篇六曲（1–6）+《相遇的圆舞曲》变奏集六首（7–12）。
##
## 做法：和声进行 + 左手织体用程序铺开（这部分是 gal 钢琴 BGM 的通用骨架，
## 手写既啰嗦又容易出错），右手旋律逐句手写 —— 旋律才是曲子的身份，不能生成。
##
## 全部原创，不使用任何既有乐曲素材。调性与进行：
##   1 序章   C 大调   I–V–vi–IV                72 BPM 4/4  32 小节
##   2 相遇   Ab 大调  I–vi–ii–V 圆舞曲         132 BPM 3/4  48 小节
##   3 思念   A 小调   i–bVI–bIII–bVII          58 BPM 4/4  24 小节
##   4 雨中   F# 小调  i–iv–bVII–bIII           72 BPM 4/4  32 小节
##   5 告白   Db→Eb   4536（IV–V–iii–vi）       76 BPM 4/4  32 小节
##   6 告别   Gm→G     i–bVI–bVII–V 收属和弦    54 BPM 4/4  24 小节
##
## 变奏集（同一套引擎与配器，全部 3/4 圆舞曲，动机取自第 2 首）：
##   7 序奏的圆舞曲  Ab 大调   84 BPM 3/4  24 小节   稀疏，音乐盒先唱
##   8 重逢的圆舞曲  Ab 大调  132 BPM 3/4  48 小节   同调同速，织体更厚
##   9 小步的圆舞曲  Ab 大调  108 BPM 3/4  32 小节   分解和弦贴身，级进旋律
##  10 月下的圆舞曲   F 小调   96 BPM 3/4  32 小节   关系小调，低音区长音
##  11 旋转的圆舞曲  Ab 大调  168 BPM 3/4  48 小节   全奏高潮，八分跑动
##  12 终场的圆舞曲  Ab 大调   72 BPM 3/4  32 小节   宽广大句，收属和弦

const Theory := preload("res://tools/bgm_glasshouse/theory.gd")

var ev: Array = []
var _rng: RandomNumberGenerator = null


# ─────────────────────────── 基础写入 ───────────────────────────

func _ev(layer: String, beat: float, m: int, dur_beats: float, vel: float, pan: float) -> void:
	ev.append({"layer": layer, "t": beat, "m": m, "d": dur_beats, "v": clampf(vel, 0.02, 1.0), "pan": pan})


## 把一小节的 [拍内位置, 音名, 时值, 力度] 列表落到指定小节。
func _mel(bar: int, bpb: int, notes: Array, pan: float, vel_scale: float = 1.0, layer: String = "piano") -> void:
	var base := float(bar * bpb)
	for n in notes:
		_ev(layer, base + float(n[0]), Theory.midi(String(n[1])), float(n[2]), float(n[3]) * vel_scale, pan)


## 把一段跨多小节的旋律（拍位从小节起点算起）落到起始小节。
func _phrase(bar: int, bpb: int, notes: Array, pan: float, vel_scale: float = 1.0) -> void:
	var base := float(bar * bpb)
	for n in notes:
		_ev("piano", base + float(n[0]), Theory.midi(String(n[1])), float(n[2]), float(n[3]) * vel_scale, pan)


## 左手：柱式和弦，每 step 拍落一次。
func _lh_block(bar: int, bpb: int, notes: Array, step: float, dur: float, vel: float, pan: float) -> void:
	var base := float(bar * bpb)
	var p := 0.0
	while p < float(bpb):
		for n in notes:
			_ev("piano", base + p, int(n), dur, vel, pan)
		p += step


## 左手：八分/十六分分解和弦，上行再下行。
func _lh_arp(bar: int, bpb: int, notes: Array, step: float, vel: float, pan_lo: float, pan_hi: float) -> void:
	var n := notes.size()
	if n == 0:
		return
	var pat: Array = []
	for i in n:
		pat.append(i)
	for i in range(n - 2, 0, -1):
		pat.append(i)
	var base := float(bar * bpb)
	var k := 0
	var p := 0.0
	var span := float(maxi(1, n - 1))
	while p < float(bpb):
		var idx: int = pat[k % pat.size()]
		var pan := lerpf(pan_lo, pan_hi, float(idx) / span)
		_ev("piano", base + p, int(notes[idx]), step * 0.92, vel, pan)
		k += 1
		p += step


## 左手：低音 + 上方和弦音交替（比纯琶音更“歌唱”）。
func _lh_alt(bar: int, bpb: int, low: Array, upper: Array, step: float, vel: float) -> void:
	var base := float(bar * bpb)
	var p := 0.0
	var flip := false
	while p < float(bpb):
		var src: Array = low if flip else upper
		var pan := -0.42 if flip else -0.20
		for n in src:
			_ev("piano", base + p, int(n), step * 0.9, vel * (1.0 if flip else 0.82), pan)
		flip = not flip
		p += step


## 圆舞曲：第 1 拍低音，第 2、3 拍上方和弦。
func _waltz(bar: int, low: int, upper: Array, vel: float) -> void:
	var base := float(bar * 3)
	_ev("piano", base, low, 0.92, vel, -0.45)
	for n in upper:
		_ev("piano", base + 1.0, int(n), 0.42, vel * 0.62, -0.15)
		_ev("piano", base + 2.0, int(n), 0.42, vel * 0.55, -0.15)


## 弦乐垫：整小节铺一个长音，和弦音之间左右铺开。
func _pad(bar: int, bpb: int, notes: Array, bars: int, vel: float) -> void:
	var base := float(bar * bpb)
	var span := float(bars * bpb)
	var n := notes.size()
	for i in n:
		var pan := 0.0
		if n > 1:
			pan = clampf(float(i) / float(n - 1) * 1.4 - 0.7, -0.7, 0.7)
		_ev("pad", base, int(notes[i]), span, vel, pan)


## 音乐盒点缀。
func _mb(bar: int, bpb: int, notes: Array, pan: float, vel_scale: float = 1.0) -> void:
	var base := float(bar * bpb)
	for n in notes:
		_ev("mb", base + float(n[0]), Theory.midi(String(n[1])), float(n[2]), float(n[3]) * vel_scale, pan)


## 人性化：±12 ms 的时值抖动，避免听起来像节拍器。
func _humanize(seed_value: int, beats_jitter: float = 0.013) -> void:
	var r := RandomNumberGenerator.new()
	r.seed = seed_value
	for e in ev:
		e["t"] = maxf(0.0, float(e["t"]) + r.randf_range(-beats_jitter, beats_jitter))
		e["v"] = clampf(float(e["v"]) * r.randf_range(0.94, 1.06), 0.02, 1.0)


func _track(key: String, title: String, bpm: float, time_sig: String, bars: int, seed_value: int) -> Dictionary:
	_humanize(seed_value)
	return {
		"key": key, "title": title, "bpm": bpm, "time_sig": time_sig,
		"bars": bars, "seed": seed_value, "events": ev,
	}


# ─────────────────────────── 1. 序章 ───────────────────────────

func _t_prologue() -> Dictionary:
	ev = []
	var bpb := 4
	# 每 2 小节一个和弦，共 16 个
	var prog := [
		"C", "Am7", "Fmaj7", "G", "C", "Am7", "Fmaj7", "G",
		"Fmaj7", "G", "C", "Am7", "Fmaj7", "G", "C", "C",
	]
	var lows := [36, 33, 29, 31, 36, 33, 29, 31, 29, 31, 36, 33, 29, 31, 36, 36]
	for i in prog.size():
		var bar := i * 2
		var ch := Theory.chord(prog[i], 55)          # 上方和弦铺在 G3 附近
		var low: int = lows[i]
		# 左手：低音 + 五音长音（两小节），极稀疏
		_ev("piano", float(bar * bpb), low, 6.0, 0.34, -0.45)
		_ev("piano", float(bar * bpb), low + 7, 6.0, 0.26, -0.35)
		_ev("piano", float(bar * bpb + 4.0), ch[0], 3.6, 0.22, -0.28)
		# 弦乐垫从第 9 小节（第二遍）开始进
		if bar >= 16:
			_pad(bar, bpb, _pad_voicing(prog[i], 60), 2, 0.38)

	# 右手旋律：A 句（1–8 小节）
	_phrase(0, bpb, [
		[0.0, "E5", 2.0, 0.52], [2.0, "G5", 2.0, 0.48],
		[4.0, "A5", 3.0, 0.55], [7.0, "G5", 1.0, 0.46],
		[8.0, "F5", 2.0, 0.50], [10.0, "E5", 2.0, 0.46],
		[12.0, "D5", 4.0, 0.52],
		[16.0, "E5", 2.0, 0.50], [18.0, "C5", 2.0, 0.44],
		[20.0, "D5", 3.0, 0.50], [23.0, "E5", 1.0, 0.44],
		[24.0, "F5", 2.0, 0.52], [26.0, "G5", 2.0, 0.50],
		[28.0, "D5", 4.0, 0.48],
	], 0.34)
	# B 句（9–16 小节）
	_phrase(8, bpb, [
		[0.0, "G5", 2.0, 0.54], [2.0, "A5", 2.0, 0.50],
		[4.0, "G5", 3.0, 0.54], [7.0, "E5", 1.0, 0.46],
		[8.0, "A5", 2.0, 0.55], [10.0, "G5", 2.0, 0.50],
		[12.0, "F5", 4.0, 0.52],
		[16.0, "E5", 2.0, 0.50], [18.0, "D5", 2.0, 0.46],
		[20.0, "C5", 3.0, 0.50], [23.0, "D5", 1.0, 0.44],
		[24.0, "E5", 2.0, 0.52], [26.0, "F5", 2.0, 0.50],
		[28.0, "G5", 4.0, 0.56],
	], 0.34)
	# A' 句（17–24），旋律抬高八度作回答
	_phrase(16, bpb, [
		[0.0, "E6", 2.0, 0.42], [2.0, "G5", 2.0, 0.40],
		[4.0, "A5", 3.0, 0.46], [7.0, "G5", 1.0, 0.38],
		[8.0, "F5", 2.0, 0.42], [10.0, "E5", 2.0, 0.38],
		[12.0, "D5", 4.0, 0.44],
		[16.0, "E5", 2.0, 0.44], [18.0, "C5", 2.0, 0.38],
		[20.0, "D5", 3.0, 0.44], [23.0, "E5", 1.0, 0.38],
		[24.0, "F5", 2.0, 0.46], [26.0, "A5", 2.0, 0.44],
		[28.0, "G5", 4.0, 0.42],
	], 0.34)
	# B' 句（25–32），收束
	_phrase(24, bpb, [
		[0.0, "A5", 2.0, 0.52], [2.0, "G5", 2.0, 0.48],
		[4.0, "E5", 3.0, 0.50], [7.0, "G5", 1.0, 0.44],
		[8.0, "F5", 2.0, 0.52], [10.0, "A5", 2.0, 0.50],
		[12.0, "G5", 4.0, 0.50],
		[16.0, "A5", 2.0, 0.50], [18.0, "B5", 2.0, 0.46],
		[20.0, "C6", 4.0, 0.54],
		[24.0, "A5", 2.0, 0.48], [26.0, "G5", 2.0, 0.44],
		[28.0, "E5", 4.0, 0.46],
	], 0.34)
	# 音乐盒：每 4 小节在高音区点一下
	for bar in [4, 8, 12, 16, 20, 24, 28]:
		_mb(bar, bpb, [[0.0, "E6", 1.6, 0.30], [2.0, "G6", 1.6, 0.24]], 0.52)

	return _track("glasshouse_01_prologue", "序章", 72.0, "4/4", 32, 101)


func _pad_voicing(sym: String, lowest: int) -> Array:
	var ch := Theory.chord(sym, lowest)
	var out: Array = []
	for n in ch:
		out.append(int(n))
	return out


# ─────────────────────────── 2. 相遇 ───────────────────────────

func _t_meeting() -> Dictionary:
	ev = []
	var bpb := 3
	var cycle := ["Ab", "Fm7", "Bbm7", "Eb7"]
	var lows := [44, 41, 46, 39]
	for rep in 6:
		for i in cycle.size():
			var bar := rep * 4 + i
			var upper := Theory.chord(cycle[i], 68)
			_waltz(bar, lows[i], [upper[1], upper[2]], 0.30 + 0.02 * float(rep % 2))
			if rep >= 2:
				_pad(bar, bpb, Theory.chord(cycle[i], 63), 1, 0.30 + 0.03 * float(rep - 2))

	# 主句 A：轻快上行
	_phrase(0, bpb, [
		[0.0, "Ab4", 1.0, 0.52], [1.0, "C5", 1.0, 0.48], [2.0, "Eb5", 1.0, 0.50],
		[3.0, "C5", 2.0, 0.46], [5.0, "Bb4", 1.0, 0.44],
		[6.0, "Ab4", 1.5, 0.50], [7.5, "C5", 1.5, 0.46],
		[9.0, "Eb5", 1.0, 0.52], [10.0, "F5", 1.0, 0.48], [11.0, "Eb5", 1.0, 0.44],
		[12.0, "Db5", 2.0, 0.50], [14.0, "C5", 1.0, 0.44],
		[15.0, "Eb5", 1.0, 0.50], [16.0, "C5", 1.0, 0.46], [17.0, "Ab4", 1.0, 0.44],
		[18.0, "Bb4", 3.0, 0.48],
	], 0.36)
	# 主句 B：回应
	_phrase(8, bpb, [
		[0.0, "C5", 1.0, 0.52], [1.0, "Eb5", 1.0, 0.48], [2.0, "F5", 1.0, 0.50],
		[3.0, "Eb5", 2.0, 0.46], [5.0, "C5", 1.0, 0.44],
		[6.0, "Ab4", 1.5, 0.50], [7.5, "Bb4", 1.5, 0.46],
		[9.0, "C5", 1.0, 0.52], [10.0, "Db5", 1.0, 0.48], [11.0, "C5", 1.0, 0.44],
		[12.0, "Bb4", 2.0, 0.50], [14.0, "Ab4", 1.0, 0.44],
		[15.0, "G4", 1.0, 0.46], [16.0, "Ab4", 3.0, 0.48],
	], 0.36)
	# 中段：把 A 句抬八度，情绪推起
	_phrase(16, bpb, [
		[0.0, "Ab5", 1.0, 0.50], [1.0, "C6", 1.0, 0.46], [2.0, "Eb5", 1.0, 0.48],
		[3.0, "C5", 2.0, 0.44], [5.0, "Bb4", 1.0, 0.42],
		[6.0, "Ab4", 1.5, 0.48], [7.5, "C5", 1.5, 0.44],
		[9.0, "Eb5", 1.0, 0.50], [10.0, "F5", 1.0, 0.46], [11.0, "Eb5", 1.0, 0.42],
		[12.0, "Db5", 2.0, 0.48], [14.0, "C5", 1.0, 0.42],
		[15.0, "Bb4", 1.0, 0.44], [16.0, "C5", 1.0, 0.42], [17.0, "Ab4", 1.0, 0.42],
		[18.0, "Bb4", 3.0, 0.46],
	], 0.36)
	# 倒数第三句：把 A 句的尾巴拉长
	_phrase(24, bpb, [
		[0.0, "Ab4", 1.0, 0.50], [1.0, "C5", 1.0, 0.46], [2.0, "Eb5", 1.0, 0.48],
		[3.0, "F5", 2.0, 0.46], [5.0, "Eb5", 1.0, 0.42],
		[6.0, "C5", 1.5, 0.48], [7.5, "Bb4", 1.5, 0.44],
		[9.0, "Ab4", 1.0, 0.48], [10.0, "Bb4", 1.0, 0.44], [11.0, "C5", 1.0, 0.46],
		[12.0, "Ab4", 2.0, 0.50], [14.0, "Bb4", 1.0, 0.44],
		[15.0, "C5", 1.0, 0.48], [16.0, "Db5", 1.0, 0.50], [17.0, "C5", 1.0, 0.46],
		[18.0, "Bb4", 3.0, 0.48],
		[21.0, "Ab4", 3.0, 0.46],
	], 0.36)
	# 副歌感的一段：连续八分往上推
	_phrase(32, bpb, [
		[0.0, "C5", 1.0, 0.54], [1.0, "Eb5", 1.0, 0.50], [2.0, "F5", 1.0, 0.52],
		[3.0, "Eb5", 1.0, 0.48], [4.0, "C5", 1.0, 0.52], [5.0, "Bb4", 1.0, 0.48],
