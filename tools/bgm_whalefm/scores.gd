extends RefCounted
## 《鲸落电台》六曲的乐谱定义。
##
## 与《玻璃温室》同一套做法：和声 / 织体 / 鼓点用程序铺开（省事、不易错），
## 旋律与动机逐句手写 —— 旋律是曲子的身份。全部原创。
##
## 六首是一条电台节目单（Whale-Fall FM 88.5）：
##   1 调频 88.5     C 大调   Cmaj7–Em7–Fmaj7–G7sus4     72 BPM  32 小节  标题
##   2 防波堤散步道   F 大调   Fmaj7–Dm7–Gm7–C7          86 BPM  32 小节  街区白天
##   3 便利店暖光     Ab 大调  Abmaj7–Fm9–Bbm7–Eb7sus4   76 BPM  32 小节  室内
##   4 夜航灯        D 小调   Dm9–Bbmaj7–Gm7–A7sus4     66 BPM  32 小节  街区夜晚
##   5 集装箱突围     E 小调   Em7–Cmaj7–Am7–B7          96 BPM  32 小节  潮汐试炼
##   6 退潮，晨光     G 大调   Gmaj7–Em7–Cmaj7–D6        72 BPM  32 小节  已通关
##
## swing：反拍（x.5）整体推后 _swing_amt 拍，16 分推后 45% —— Lo-fi 的呼吸感。

const Theory := preload("res://tools/bgm_glasshouse/theory.gd")

var ev: Array = []
var _swing_amt := 0.13

## 鼓件默认声像：镲偏左、沙锤偏右、军鼓居中略左。
const DRUM_PAN := {
	"kick": 0.0, "snare": -0.06, "rim": 0.22,
	"hat": -0.30, "ohat": -0.30, "shaker": 0.35,
}


# ─────────────────────────── 基础写入 ───────────────────────────

func _ev(layer: String, beat: float, m: int, dur_beats: float, vel: float, pan: float) -> void:
	ev.append({"layer": layer, "t": maxf(0.0, beat), "m": m, "d": dur_beats, "v": clampf(vel, 0.02, 1.0), "pan": pan})


## swing：反拍推后 _swing_amt，16 分位推后 45%。
func _sw(t: float) -> float:
	var frac: float = t - floor(t)
	if frac > 0.49 and frac < 0.51:
		return t + _swing_amt
	if (frac > 0.24 and frac < 0.26) or (frac > 0.74 and frac < 0.76):
		return t + _swing_amt * 0.45
	return t


## 旋律 / 动机（层默认 ep）。notes: [拍位, 音名, 时值, 力度]。
func _mel(bar: int, notes: Array, pan: float = 0.18, vel_scale: float = 1.0, layer: String = "ep") -> void:
	var base := float(bar * 4)
	for n in notes:
		_ev(layer, base + _sw(float(n[0])), Theory.midi(String(n[1])), float(n[2]), float(n[3]) * vel_scale, pan)


## 电钢和弦（MIDI 数字数组整体落一拍位）。
func _chord(bar: int, beat: float, notes: Array, dur: float, vel: float, pan: float = -0.22) -> void:
	for m in notes:
		_ev("ep", float(bar * 4) + _sw(beat), int(m), dur, vel, pan)


## 贝斯线。notes: [拍位, 音名, 时值, 力度]。
func _bass(bar: int, notes: Array) -> void:
	var base := float(bar * 4)
	for n in notes:
		_ev("bass", base + _sw(float(n[0])), Theory.midi(String(n[1])), float(n[2]), float(n[3]), 0.0)


## 一小节的鼓。pat: {件名: [拍位…]}，力度统一缩放。
func _drum_bar(bar: int, pat: Dictionary, vel_scale: float = 1.0) -> void:
	var base := float(bar * 4)
	for voice in pat:
		var pan: float = float(DRUM_PAN.get(voice, 0.0))
		for b in pat[voice]:
			_ev(voice, base + _sw(float(b)), 60, 0.0, 0.62 * vel_scale, pan)


## 鼓段落：按 pattern 字典铺多小节。bars_count 小节，pattern 变化用 lambda 取每小节 pat。
func _drum_bars(from_bar: int, count: int, pat_of: Callable, vel_scale: float = 1.0) -> void:
	for i in count:
		var pat: Dictionary = pat_of.call(i)
		if not pat.is_empty():
			_drum_bar(from_bar + i, pat, vel_scale)


## rootless 壳式 voicing：Theory.chord 去掉根音（贝斯已铺），可选拍上九音，压进 55–79。
func _shell(sym: String, lowest: int, add9: bool = false) -> Array:
	var ch := Theory.chord(sym, lowest)
	if ch.is_empty():
		return [lowest + 7, lowest + 12, lowest + 16]
	var root := int(ch[0])
	ch = ch.slice(1)
	if add9:
		ch = ch.duplicate()
		ch.append(root + 14)   # 根音 + 14 半音 = 上方九音
	var out: Array = []
	for m in ch:
		var v := int(m)
		while v < lowest + 3:
			v += 12
		while v > lowest + 22:
			v -= 12
		out.append(v)
	return out


## 人性化：±13 ms 时值抖动 + ±6% 力度抖动。
func _humanize(seed_value: int, beats_jitter: float = 0.013) -> void:
	var r := RandomNumberGenerator.new()
	r.seed = seed_value
	for e in ev:
		e["t"] = maxf(0.0, float(e["t"]) + r.randf_range(-beats_jitter, beats_jitter))
		e["v"] = clampf(float(e["v"]) * r.randf_range(0.94, 1.06), 0.02, 1.0)


func _track(key: String, title: String, bpm: float, bars: int, seed_value: int) -> Dictionary:
	_humanize(seed_value)
	return {
		"key": key, "title": title, "bpm": bpm, "time_sig": "4/4",
		"bars": bars, "seed": seed_value, "events": ev,
	}


# ─────────────────────────── 1. 调频 88.5（标题） ───────────────────────────
# 电台开机曲：前 8 小节只有黑胶与电钢独白，鼓组慢慢醒来，最后两小节退回黑胶，
# 首尾都安静，无缝循环正好是「电台永远在播」的感觉。

func _t_fm885() -> Dictionary:
	ev = []
	_swing_amt = 0.15
	var prog := ["Cmaj7", "Em7", "Fmaj7", "G7sus4"]
	var roots := ["C2", "E2", "F2", "G2"]
	var shell := [
		_shell("Cmaj7", 55, true), _shell("Em7", 55, false),
		_shell("Fmaj7", 53, true), _shell("G7sus4", 53, false),
	]

	# --- 电钢和声骨架：每 2 小节一个和弦；开头四组铺满两小节，不留断档 ---
	for i in 16:
		var bar := i * 2
		var c := i % 4
		if i == 15:
			_chord(bar, 0.0, shell[0], 7.4, 0.30)
			continue
		# 前 8 小节是电台开机段，只有电钢，长音必须撑满两小节
		var hold := 7.6 if bar < 8 else 3.8
		_chord(bar, 0.0, shell[c], hold, 0.30 if bar < 8 else 0.34)
		# off-beat 回应（第 9 小节起）
		if bar >= 8:
			_chord(bar, 2.5, shell[c], 1.2, 0.20)

	# --- 开机段的「信号音」：高音区极轻的单音点，像远处电台在发报 ---
	_mel(0, [
		[0.0, "G5", 1.5, 0.20], [3.0, "E5", 1.0, 0.16],
		[4.5, "C6", 1.0, 0.18], [7.0, "A5", 1.5, 0.16],
		[8.5, "G5", 1.0, 0.18], [11.0, "C6", 1.5, 0.20],
		[13.0, "E6", 1.0, 0.16], [15.0, "D6", 2.0, 0.18],
		[16.5, "C6", 1.5, 0.20], [19.0, "A5", 1.0, 0.16],
		[20.5, "G5", 1.5, 0.18], [23.0, "E5", 1.0, 0.16],
		[24.5, "F5", 1.5, 0.18], [27.0, "A5", 1.0, 0.16],
		[28.5, "G5", 1.5, 0.18], [31.0, "E5", 1.0, 0.16],
	], 0.40, 0.85)

	# --- 开机段的低音托底：每小节一个根音长音。极轻，但电钢衰减后不至于掉进静音 ---
	for bar in 8:
		var c0 := (bar / 2) % 4
		_bass(bar, [[0.0, roots[c0], 3.6, 0.30]])

	# --- 贝斯：第 9 小节进，根音长音 + 五度路过 ---
	for i in range(4, 16):
		var bar := i * 2
		var c := i % 4
		_bass(bar, [[0.0, roots[c], 3.0, 0.55], [3.5, roots[c], 0.4, 0.32]])
		if bar >= 16:
			_bass(bar, [[2.5, roots[c], 0.8, 0.38]])

	# --- 鼓：8–15 rim+shaker；16–23 加 kick；24–29 退回；30–31 无鼓 ---
	_drum_bars(8, 8, func(i): return {
		"rim": [1.0, 3.0],
		"shaker": [0.5, 1.5, 2.5, 3.5],
		"kick": [0.0] if i % 2 == 0 else [],
	}, 0.62)
	_drum_bars(16, 8, func(i): return {
		"rim": [1.0, 3.0],
		"shaker": [0.5, 1.5, 2.5, 3.5],
		"kick": [0.0, 2.5],
	}, 0.72)
	_drum_bars(24, 6, func(i): return {
		"rim": [1.0, 3.0],
		"shaker": [0.5, 2.5],
		"kick": [0.0] if i % 2 == 0 else [],
	}, 0.58)

	# --- 旋律 A（8–15）：慵懒下行，落在反拍上 ---
	_mel(8, [
		[0.5, "E5", 1.0, 0.50], [1.5, "G5", 0.5, 0.44], [2.0, "A5", 1.5, 0.52],
		[4.0, "G5", 2.0, 0.48], [6.5, "E5", 1.0, 0.42],
		[8.5, "F5", 1.0, 0.48], [9.5, "A5", 1.0, 0.46], [10.5, "G5", 1.0, 0.50],
		[12.0, "E5", 3.0, 0.50], [15.5, "D5", 0.5, 0.36],
		[16.5, "C5", 1.0, 0.46], [17.5, "D5", 0.5, 0.40], [18.0, "E5", 1.0, 0.48],
		[20.0, "G5", 2.5, 0.52], [23.0, "E5", 0.5, 0.38],
		[24.5, "F5", 0.5, 0.44], [25.0, "E5", 0.5, 0.40], [25.5, "D5", 1.0, 0.46],
		[28.0, "D5", 3.5, 0.48],
	])
	# --- 旋律 B（16–23）：抬到高音区作答句 ---
	_mel(16, [
		[0.5, "A5", 0.5, 0.48], [1.5, "B5", 0.5, 0.46], [2.0, "C6", 2.0, 0.54],
		[4.5, "B5", 1.0, 0.46], [5.5, "G5", 1.0, 0.44], [6.5, "A5", 1.5, 0.50],
		[8.5, "G5", 2.0, 0.48], [11.0, "E5", 1.0, 0.42],
		[12.5, "F5", 1.5, 0.48], [14.5, "G5", 1.5, 0.48],
		[16.5, "E5", 1.0, 0.46], [17.5, "C5", 1.0, 0.42], [18.0, "D5", 2.0, 0.48],
		[20.5, "E5", 1.5, 0.48], [22.5, "D5", 1.0, 0.42], [23.5, "C5", 0.5, 0.38],
		[24.5, "A4", 1.0, 0.42], [25.5, "C5", 1.0, 0.44], [26.0, "D5", 1.5, 0.46],
		[28.0, "E5", 3.0, 0.50],
	])
	# --- 旋律 A'（24–31）：回归与收束，落回 C 并铺满到循环末 ---
	_mel(24, [
		[0.5, "E5", 1.0, 0.46], [1.5, "G5", 0.5, 0.42], [2.0, "A5", 1.5, 0.50],
		[4.0, "G5", 2.0, 0.46], [6.5, "E5", 1.0, 0.40],
		[8.5, "F5", 1.0, 0.46], [9.5, "A5", 1.0, 0.44], [10.5, "G5", 1.0, 0.48],
		[12.0, "E5", 2.5, 0.48],
		[16.5, "D5", 1.0, 0.44], [17.5, "C5", 1.0, 0.42],
		[20.0, "C5", 12.0, 0.46],   # 铺满最后两小节，接回开头不断档
	], 0.18, 0.94)
	# 最后两小节留极轻的沙锤空气感（鼓组已收，但循环不能掉进静音）
	_drum_bars(30, 2, func(i): return {"shaker": [0.5, 2.5]}, 0.34)
	# 低音托到最后；信号音重现开机段，循环接回开头是同一个画面
	_bass(30, [[0.0, "C2", 7.6, 0.32]])
	_mel(30, [
		[0.5, "G5", 1.5, 0.20], [2.5, "E5", 1.0, 0.18],
		[4.0, "C6", 1.5, 0.20], [6.0, "A5", 1.5, 0.18],
	], 0.40, 0.85)

	return _track("wf_01_fm885", "调频 88.5", 72.0, 32, 7101)


# ─────────────────────────── 2. 防波堤散步道（街区 · 白天） ───────────────────────────
# 白天的标准 lo-fi beat：kick 0/2.5，军鼓 2/4，swing hat。旋律轻快，像沿着海堤散步。

func _t_breakwater() -> Dictionary:
	ev = []
	_swing_amt = 0.12
	var prog := ["Fmaj7", "Dm7", "Gm7", "C7"]
	var roots := ["F2", "D2", "G1", "C2"]
	var fifths := ["C2", "A1", "D2", "G2"]
	var shells := [
		_shell("Fmaj7", 53, true), _shell("Dm7", 53, false),
		_shell("Gm7", 50, true), _shell("C7", 52, false),
	]

	for i in 16:
		var bar := i * 2
		var c := i % 4
		_chord(bar, 0.0, shells[c], 2.6, 0.30)
		_chord(bar, 1.5, shells[c], 1.0, 0.24)
		_chord(bar + 1, 0.0, shells[c], 2.2, 0.26)
		if i % 2 == 1:
			_chord(bar + 1, 2.5, shells[c], 1.0, 0.22)

	# --- 贝斯：根音 + 五音 + 半拍过渡 ---
	for i in 16:
		var bar := i * 2
		var c := i % 4
		_bass(bar, [[0.0, roots[c], 1.8, 0.60], [2.5, fifths[c], 1.0, 0.46]])
		_bass(bar + 1, [[0.0, roots[c], 1.5, 0.52], [3.5, roots[(c + 1) % 4], 0.5, 0.36]])

	# --- 鼓：标准 beat，第 4 小节末开镲换气 ---
	var hat8 := [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5]
	var pat_bw := func(i: int) -> Dictionary:
		var pat := {"kick": [0.0, 2.5], "snare": [1.0, 3.0], "hat": hat8.duplicate()}
		if i % 4 == 3:
			pat["ohat"] = [3.5]
			pat["hat"] = [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0]
		if i >= 16:
			pat["kick"].append(1.75)
		return pat
	_drum_bars(0, 32, pat_bw, 0.66)

	# --- 旋律 A（0–15，两遍 8 小节乐句） ---
	_mel(0, [
		[0.5, "A5", 0.5, 0.50], [1.0, "C6", 1.0, 0.54], [2.0, "A5", 0.5, 0.46], [2.5, "F5", 1.5, 0.50],
		[4.5, "G5", 1.5, 0.48], [6.5, "A5", 0.5, 0.44], [7.0, "C6", 1.0, 0.50],
		[8.5, "D6", 1.0, 0.54], [9.5, "C6", 1.0, 0.48], [10.5, "A5", 1.5, 0.50],
		[12.5, "C6", 1.5, 0.52], [14.0, "A5", 2.0, 0.48],
	])
	_mel(8, [
		[0.5, "A5", 0.5, 0.48], [1.0, "C6", 1.0, 0.52], [2.0, "D6", 0.5, 0.50], [2.5, "C6", 1.5, 0.52],
		[4.5, "A5", 1.0, 0.46], [5.5, "G5", 1.0, 0.44], [6.5, "F5", 1.5, 0.48],
		[8.5, "G5", 0.5, 0.46], [9.0, "A5", 1.0, 0.48], [10.5, "Bb5", 1.0, 0.50], [11.5, "C6", 1.5, 0.54],
		[13.5, "D6", 1.0, 0.52], [14.5, "C6", 1.0, 0.48], [15.5, "A5", 0.5, 0.44],
	])
	# --- 旋律空档的轻点缀（器乐间奏感） ---
	for seg in [4, 20]:
		_mel(seg, [[1.5, "C5", 1.0, 0.28], [3.0, "A4", 1.0, 0.26]], 0.05, 0.9)
	_mel(12, [[1.5, "Bb5", 1.0, 0.30], [3.0, "G5", 1.0, 0.28]], 0.05, 0.9)

	# --- 旋律 B（16–23）：转低回一句 ---
	_mel(16, [
		[0.5, "F5", 1.0, 0.48], [1.5, "G5", 0.5, 0.44], [2.0, "A5", 1.5, 0.50],
		[4.0, "D5", 1.0, 0.42], [5.0, "F5", 1.5, 0.48],
		[8.5, "G5", 1.0, 0.46], [9.5, "Bb5", 0.5, 0.46], [10.0, "C6", 1.5, 0.52],
		[12.0, "Bb5", 1.0, 0.46], [13.0, "G5", 1.0, 0.44], [14.0, "A5", 2.0, 0.50],
	])
	# --- 旋律 A'（24–31）：抬八度收尾 ---
	_mel(24, [
		[0.5, "A5", 0.5, 0.46], [1.0, "C6", 1.0, 0.52], [2.0, "A5", 0.5, 0.44], [2.5, "F5", 1.5, 0.48],
		[4.5, "G5", 1.5, 0.46], [6.5, "A5", 0.5, 0.42], [7.0, "C6", 1.0, 0.48],
		[8.5, "D6", 1.0, 0.52], [9.5, "C6", 1.0, 0.46], [10.5, "A5", 1.5, 0.48],
		[12.5, "F6", 1.5, 0.52], [14.0, "E6", 2.0, 0.50],
		[16.5, "D6", 1.5, 0.48], [18.5, "C6", 1.5, 0.46], [20.0, "A5", 3.0, 0.46],
	])

	return _track("wf_02_breakwater", "防波堤散步道", 86.0, 32, 7102)


# ─────────────────────────── 3. 便利店暖光（室内） ───────────────────────────
# 3625 的温柔循环，鼓几乎只剩边击与沙锤，电钢慢分解。深夜便利店的暖光。

func _t_konbini() -> Dictionary:
	ev = []
	_swing_amt = 0.14
	var prog := ["Abmaj7", "Fm9", "Bbm7", "Eb7sus4"]
	var roots := ["Ab1", "F1", "Bb1", "Eb2"]
	var shells := [
		_shell("Abmaj7", 56, true), _shell("Fm9", 53, false),
		_shell("Bbm7", 53, true), _shell("Eb7sus4", 55, false),
	]

	for i in 16:
		var bar := i * 2
		var c := i % 4
		var v := 0.34 if i < 8 else 0.38
		# 慢分解：根五长音 + 3 音 + 高音点缀
		_chord(bar, 0.0, [shells[c][0], shells[c][1]], 3.6, v)
		_chord(bar, 1.5, [shells[c][2]], 1.4, v * 0.8, -0.10)
		_chord(bar + 1, 0.5, [shells[c][1], shells[c][2]], 2.0, v * 0.85, 0.05)
		if i >= 8:
			_chord(bar + 1, 2.5, [shells[c][0] + 12], 1.2, v * 0.6, 0.30)

	# --- 贝斯：几乎全是长音，换和弦前半拍轻轻走过去 ---
	for i in 16:
		var bar := i * 2
		var c := i % 4
		_bass(bar, [[0.0, roots[c], 3.5, 0.52]])
		_bass(bar + 1, [[0.0, roots[c], 3.0, 0.46], [3.5, roots[(c + 1) % 4], 0.5, 0.30]])

	# --- 鼓：rim 2/4 + 轻 kick 每两小节 + 沙锤反拍 ---
	var pat_kb := func(i: int) -> Dictionary:
		var pat := {"rim": [1.0, 3.0], "shaker": [0.5, 1.5, 2.5, 3.5]}
		if i % 2 == 0:
			pat["kick"] = [0.0]
		if i >= 12 and i < 24:
			pat["hat"] = [0.0, 2.0]
		return pat
	_drum_bars(4, 28, pat_kb, 0.50)

	# --- 旋律 A 变奏（8–15）：低回一句，应答前 8 小节 ---
	_mel(8, [
		[0.0, "Ab5", 2.0, 0.42], [2.0, "G5", 1.5, 0.38], [3.5, "F5", 0.5, 0.34],
		[4.0, "Eb5", 2.0, 0.40], [6.0, "F5", 1.5, 0.38],
