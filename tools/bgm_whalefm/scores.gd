# ─────────────────────────── 4. 夜航灯（街区 · 夜晚） ───────────────────────────
# half-time 的夜：kick 1 下、军鼓在第 3 拍，电钢稀疏，高音句带一拍延迟的回声。

func _t_nightlight() -> Dictionary:
	ev = []
	_swing_amt = 0.16
	var prog := ["Dm9", "Bbmaj7", "Gm7", "A7sus4"]
	var roots := ["D2", "Bb1", "G1", "A1"]
	var shells := [
		_shell("Dm9", 50, false), _shell("Bbmaj7", 53, true),
		_shell("Gm7", 50, false), _shell("A7sus4", 52, false),
	]

	for i in 16:
		var bar := i * 2
		var c := i % 4
		_chord(bar, 0.0, shells[c], 3.2, 0.30)
		_chord(bar, 2.5, shells[c], 1.4, 0.22)
		_chord(bar + 1, 0.0, shells[c], 2.8, 0.26)
		if i >= 8:
			_chord(bar + 1, 3.5, [shells[c][2]], 0.5, 0.18, 0.10)

	# --- 贝斯：低音区长鸣 ---
	for i in 16:
		var bar := i * 2
		var c := i % 4
		_bass(bar, [[0.0, roots[c], 3.5, 0.56]])
		_bass(bar + 1, [[0.0, roots[c], 2.8, 0.48], [3.0, roots[c], 0.8, 0.34]])

	# --- 鼓：half-time。hat 拍点，第 16 小节起加一点密度 ---
	_drum_bars(0, 16, func(i): return {
		"kick": [0.0], "snare": [2.0], "hat": [0.0, 1.0, 2.0, 3.0],
		"ohat": [3.5] if i % 4 == 3 else [],
	}, 0.56)
	_drum_bars(16, 16, func(i): return {
		"kick": [0.0, 2.75], "snare": [2.0], "hat": [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5],
		"ohat": [3.5] if i % 4 == 3 else [],
	}, 0.60)

	# --- 旋律 A（0–15）：慢句，两句之间留白 ---
	var mel_a := [
		[0.0, "A5", 1.5, 0.44], [2.0, "F5", 1.0, 0.40], [3.0, "D5", 2.0, 0.42],
		[6.0, "E5", 1.5, 0.40], [8.0, "F5", 2.0, 0.44], [10.5, "A5", 1.0, 0.40],
		[12.0, "G5", 2.5, 0.42], [15.0, "F5", 1.0, 0.36],
		[16.0, "E5", 1.5, 0.40], [18.0, "D5", 1.0, 0.38], [19.0, "C5", 2.0, 0.40],
		[22.0, "D5", 1.5, 0.38], [24.0, "F5", 2.0, 0.42], [26.5, "E5", 1.0, 0.38],
		[28.0, "D5", 3.0, 0.42],
	]
	_mel(0, mel_a, 0.22)
	# --- 回声层：同旋律晚一拍、力度三分之一（手写延迟效果） ---
	for n in mel_a:
		_ev("ep", _sw(float(n[0]) + 1.0), Theory.midi(String(n[1])), float(n[2]) * 0.8, float(n[3]) * 0.30, 0.42)

	# --- 8–15 小节：低音区下行点缀，让织体段也有方向感 ---
	_mel(8, [
		[0.0, "D5", 3.0, 0.30], [4.0, "C5", 3.0, 0.28],
		[8.0, "Bb4", 3.0, 0.30], [12.0, "A4", 3.0, 0.28],
	], 0.30, 0.85)

	# --- 旋律 B（16–23）：抬八度，与回声交织 ---
	_mel(16, [
		[0.0, "A6", 1.5, 0.40], [2.0, "G6", 1.0, 0.38], [3.0, "F6", 2.0, 0.42],
		[6.0, "D6", 1.5, 0.38], [8.0, "E6", 2.0, 0.40], [10.5, "F6", 1.0, 0.38],
		[12.0, "A6", 2.5, 0.42], [15.0, "G6", 1.0, 0.36],
	], 0.26, 0.88)
	# --- A'（24–31）：收 ---
	_mel(24, [
		[0.0, "F5", 1.5, 0.40], [2.0, "E5", 1.0, 0.36], [3.0, "D5", 2.0, 0.40],
		[6.0, "C5", 1.5, 0.36], [8.0, "D5", 2.0, 0.40], [10.5, "F5", 1.0, 0.38],
		[12.0, "E5", 3.0, 0.40], [16.0, "D5", 6.0, 0.40],
	], 0.22, 0.92)

	return _track("wf_04_nightlight", "夜航灯", 66.0, 32, 7104)


# ─────────────────────────── 5. 集装箱突围（潮汐试炼 · 战斗） ───────────────────────────
# 六首里唯一驱动的曲子：8 分贝斯 riff + 密 kick + 半音转折。Lo-fi 版的遭遇战。

func _t_container() -> Dictionary:
	ev = []
	_swing_amt = 0.08
	var prog := ["Em7", "Cmaj7", "Am7", "B7"]
	var roots := [40, 36, 33, 35]   # E2 C2 A1 B1
	var shells := [
		_shell("Em7", 55, false), _shell("Cmaj7", 55, true),
		_shell("Am7", 52, false), _shell("B7", 54, false),
	]

	for i in 32:
		var c := i % 4
		var shell: Array = shells[c]
		var root: int = roots[c]
		# 倒数第二小节：B7 → Bb7 半音转折；最后一小节回 Em 收束
		if i == 30:
			shell = _shell("Bb7", 53, false)
			root = 34
		if i == 31:
			shell = shells[0]
			root = roots[0]
		# --- 贝斯 riff：8 分驱动，五音与降七音穿插（直接用 MIDI 偏移写底层事件） ---
		var riff := [
			[0.0, 0, 0.45, 0.66], [0.5, 0, 0.45, 0.54], [1.0, 7, 0.45, 0.50],
			[1.5, 0, 0.45, 0.56], [2.0, 10, 0.45, 0.52], [2.5, 0, 0.45, 0.54],
			[3.0, 7, 0.45, 0.48], [3.5, 10, 0.45, 0.46],
		]
		for n in riff:
			_ev("bass", float(i * 4) + _sw(float(n[0])), root + int(n[1]), float(n[2]), float(n[3]), 0.0)
		# --- 电钢 stab：反拍短刺 ---
		_chord(i, 0.5, shell, 0.5, 0.30)
		_chord(i, 2.5, shell, 0.5, 0.26)
		if i % 8 == 7:
			_chord(i, 3.5, shell, 0.5, 0.24)

	# --- 鼓：密。每 8 小节末小节加军鼓 fill ---
	var hat8 := [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5]
	var pat_ct := func(i: int) -> Dictionary:
		var pat := {"kick": [0.0, 1.75, 2.5], "snare": [1.0, 3.0], "hat": hat8.duplicate()}
		if i % 8 == 7:
			pat["snare"] = [1.0, 3.0, 3.5, 3.75]
		if i >= 16:
			pat["kick"].append(3.75)
		return pat
	_drum_bars(0, 32, pat_ct, 0.74)

	# --- 动机（每 4 小节一句短句，第 5、6 遍抬高） ---
	for v in 8:
		var base := v * 4
		var lift := 12 if v >= 4 else 0
		if v % 2 == 0:
			_mel(base, [
				[0.0, "B4", 0.5, 0.44], [0.5, "E5", 0.5, 0.48], [1.0, "G5", 0.5, 0.46], [1.5, "F#5", 0.5, 0.44],
				[2.0, "E5", 1.0, 0.46],
			], 0.16, 1.0)
			# 抬八度版本把音名整体上移
			if lift > 0:
				for e_idx in range(ev.size() - 5, ev.size()):
					ev[e_idx]["m"] += lift
		else:
			_mel(base, [
				[0.5, "A5", 0.5, 0.44], [1.0, "G5", 0.5, 0.42], [1.5, "E5", 0.5, 0.40], [2.0, "D5", 0.75, 0.42],
				[3.0, "B4", 0.75, 0.40],
			], 0.16)
			if lift > 0:
				for e_idx in range(ev.size() - 5, ev.size()):
					ev[e_idx]["m"] += lift

	return _track("wf_05_container", "集装箱突围", 96.0, 32, 7105)


# ─────────────────────────── 6. 退潮，晨光（已通关） ───────────────────────────
# 几乎没有鼓的尾声乐：沙锤 16 分像退潮的水纹，电钢琶音上行，B 段抬八度。

func _t_ebbtide() -> Dictionary:
	ev = []
	_swing_amt = 0.10
	var prog := ["Gmaj7", "Em7", "Cmaj7", "D6"]
	var roots := ["G1", "E1", "C2", "D2"]
	var arps := [
		[55, 59, 62, 66],   # G B D F#
		[52, 55, 59, 62],   # E G B D
		[48, 52, 55, 59],   # C E G B
		[50, 54, 57, 61],   # D F# A C#
	]

	for i in 16:
		var bar := i * 2
		var c := i % 4
		var arp: Array = arps[c]
		# --- 电钢琶音上行：8 分音符，一上一下铺两小节 ---
		var seq: Array = [arp[0], arp[1], arp[2], arp[3], arp[2], arp[1], arp[2], arp[3]]
		for k in 8:
			_ev("ep", float(bar * 4) + _sw(float(k) * 0.5), int(seq[k]), 0.55, 0.26 + 0.04 * float(k), -0.18 + 0.05 * float(k))
		for k in 4:
			_ev("ep", float((bar + 1) * 4) + _sw(float(k) * 1.0), int(arp[k % 4]), 0.95, 0.24, -0.10)
		# --- 贝斯：长音，D→G 引导 ---
		_bass(bar, [[0.0, roots[c], 6.5, 0.50]])
		_bass(bar + 1, [[2.5, roots[c], 1.2, 0.34]])

	# --- 鼓：沙锤 16 分很轻 + rim；16 小节起 kick 每小节；末 4 小节退回 ---
	var sh16 := [0.0, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 3.75]
	_drum_bars(8, 8, func(i): return {"shaker": sh16.duplicate(), "rim": [1.0, 3.0]}, 0.40)
	_drum_bars(16, 8, func(i): return {"shaker": sh16.duplicate(), "rim": [1.0, 3.0], "kick": [0.0]}, 0.48)
	_drum_bars(24, 4, func(i): return {"shaker": sh16.duplicate(), "rim": [3.0] if i % 2 == 1 else []}, 0.36)

	# --- 旋律 A（8–15）：释怀长句 ---
	_mel(8, [
		[0.0, "B4", 1.5, 0.42], [2.0, "D5", 1.0, 0.40], [3.0, "G5", 2.5, 0.46],
		[6.0, "F#5", 1.5, 0.42],
		[8.0, "E5", 1.5, 0.42], [10.0, "B4", 1.0, 0.38], [11.0, "D5", 2.0, 0.42],
		[14.0, "E5", 2.0, 0.40],
		[16.0, "G5", 1.5, 0.46], [18.0, "A5", 1.0, 0.44], [19.0, "B5", 2.5, 0.48],
		[22.0, "A5", 1.5, 0.42],
		[24.0, "F#5", 1.5, 0.44], [26.0, "D5", 1.0, 0.40], [27.0, "E5", 3.0, 0.44],
	], 0.20)
	# --- 旋律 B（16–23）：抬八度 ---
	_mel(16, [
		[0.0, "B5", 1.5, 0.42], [2.0, "D6", 1.0, 0.40], [3.0, "G6", 2.5, 0.46],
		[6.0, "F#6", 1.5, 0.42],
		[8.0, "E6", 1.5, 0.42], [10.0, "B5", 1.0, 0.38], [11.0, "D6", 2.0, 0.42],
		[14.0, "E6", 2.0, 0.40],
	], 0.24, 0.92)
	# --- A''（24–31）：收在 G ---
	_mel(24, [
		[0.0, "D6", 1.5, 0.42], [2.0, "B5", 1.0, 0.40], [3.0, "G5", 2.5, 0.44],
		[6.0, "A5", 1.5, 0.40],
		[8.0, "B5", 2.0, 0.42], [10.5, "A5", 1.0, 0.38], [11.0, "G5", 2.0, 0.42],
		[14.0, "D5", 2.0, 0.38],
		[16.0, "G5", 8.0, 0.40],
	], 0.20, 0.90)

	return _track("wf_06_ebbtide", "退潮，晨光", 72.0, 32, 7106)


